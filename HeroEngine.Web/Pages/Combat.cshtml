@page
@model HeroEngine.Web.Pages.CombatModel
@{
    ViewData["Title"] = "Combat Arena";
}

<div class="container mt-4">
    <h2 class="mb-4">⚔️ Combat Arena</h2>

    <div class="row mb-4">
        <div class="col">
            <p>Initiate a combat sequence using the registered heroes against random enemies. Results are saved to the Chronicle Keeper's archives.</p>
            <form method="post" asp-page-handler="Simulate">
                <button type="submit" class="btn btn-danger btn-lg shadow">Start Combat</button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card bg-dark text-white shadow">
                <div class="card-header border-bottom border-secondary">
                    <h5 class="mb-0 text-success">📜 Last Combat Log </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.LastCombatLog))
                    {
                        <pre style="color: #00ff00; font-family: 'Courier New', Courier, monospace; white-space: pre-wrap;">@Model.LastCombatLog</pre>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No combat records found yet. Start a combat to generate the log file.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>