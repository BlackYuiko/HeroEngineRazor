@page
@model HeroEngine.Web.Pages.Files.IndexModel
@{
    ViewData["Title"] = "Kingdom Archives & Settings";
}

<div class="container mt-4">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Kingdom Archives (CSV Statistics)</h2>

        <a asp-page-handler="DownloadCsv" class="btn btn-success">
            <i class="bi bi-download"></i> Download CSV File
        </a>
    </div>

    <div class="card shadow mb-5">
        <div class="card-body">
            <h5 class="card-title">Recent Combats (Last 10)</h5>

            @if (Model.RecentStats.Any())
            {
                <table class="table table-striped table-hover mt-3">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Heroes</th>
                            <th>Enemies</th>
                            <th>Result</th>
                            <th>Rounds</th>
                            <th>Total DMG</th>
                            <th>MVP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in Model.RecentStats)
                        {
                            <tr>
                                <td>@stat.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@stat.ParticipatingHeroes</td>
                                <td>@stat.ParticipatingEnemies</td>
                                <td>
                                    <span class="badge @(stat.Result == "Victory" ? "bg-success" : "bg-danger")">
                                        @stat.Result
                                    </span>
                                </td>
                                <td>@stat.TotalRounds</td>
                                <td>@stat.TotalDamageDealt</td>
                                <td>@stat.MostEffectiveHero</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mt-3">No combat statistics have been recorded yet. Go fight some monsters!</p>
            }
        </div>
    </div>


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear-fill"></i> Game Configuration (XML)</h2>
    </div>

    <div class="card shadow mb-5 border-primary">
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Level Multiplier</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-graph-up-arrow"></i></span>
                            <input type="number" step="any" asp-for="Config.LevelMultiplier" class="form-control" required />
                        </div>
                        <small class="text-muted">Stats increase per level up.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Enemy HP Multiplier</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-heart-pulse-fill text-danger"></i></span>
                            <input type="number" step="any" asp-for="Config.EnemyHpMultiplier" class="form-control" required />
                        </div>
                        <small class="text-muted">Multiplies base enemy health (e.g., 1.5 = 50% more HP).</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Max Combat Rounds</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-hourglass-split"></i></span>
                            <input type="number" asp-for="Config.MaxCombatRounds" class="form-control" required />
                        </div>
                        <small class="text-muted">Combats exceeding this limit end in a loss.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Max Heroes Per Battle</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-people-fill"></i></span>
                            <input type="number" asp-for="Config.MaxHeroesPerBattle" class="form-control" required />
                        </div>
                        <small class="text-muted">Party size limit for combat instances.</small>
                    </div>
                </div>

                <hr class="mt-4 mb-4" />

                <button type="submit" class="btn btn-primary w-100 p-2 fs-5">
                    <i class="bi bi-save2"></i> Save Game Settings
                </button>
            </form>
        </div>
    </div>
</div>