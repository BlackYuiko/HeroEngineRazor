@page
@model IndexModel
@{
    ViewData["Title"] = "Kingdom's Gate";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm text-center" style="background-image: linear-gradient(to right, #2c3e50, #000000);">
    <div class="container-fluid py-4">
        <h1 class="display-4 fw-bold"><i class="bi bi-shield-sword"></i> Welcome to HeroEngine Web</h1>
        <p class="col-md-8 fs-5 mx-auto mt-3 text-light">
            The official battle simulator and management portal for the Bytecroft Council.
            Create legendary heroes, simulate epic auto-battles against fearsome monsters,
            and analyze combat statistics like never before.
        </p>
        <div class="mt-4">
            <a asp-page="/Heroes/Create" class="btn btn-primary btn-lg me-2"><i class="bi bi-person-plus-fill"></i> Recruit Hero</a>
            <a asp-page="/Combat" class="btn btn-danger btn-lg"><i class="bi bi-lightning-fill"></i> To the Arena!</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-5 text-center">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="bi bi-people-fill text-primary" style="font-size: 2.5rem;"></i>
                <h5 class="card-title mt-3">Hero Management</h5>
                <p class="card-text text-muted small">Manage Warriors, Mages, and Rogues. Register new heroes, equip abilities, and store them securely in JSON format.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="bi bi-swords text-danger" style="font-size: 2.5rem;"></i>
                <h5 class="card-title mt-3">Combat Simulation</h5>
                <p class="card-text text-muted small">Polymorphic turn-based combat. Watch the battle unfold round-by-round with detailed text logs saved automatically.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="bi bi-bar-chart-fill text-success" style="font-size: 2.5rem;"></i>
                <h5 class="card-title mt-3">Advanced Analytics</h5>
                <p class="card-text text-muted small">Explore the Grimoire of Knowledge. Track total damage, MVP heroes, and class distribution powered by CSV data and LINQ.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="bi bi-gear-fill text-secondary" style="font-size: 2.5rem;"></i>
                <h5 class="card-title mt-3">Dynamic Config</h5>
                <p class="card-text text-muted small">The Council dictates the rules. Tweak enemy strength and level multipliers on the fly using our XML configuration manager.</p>
            </div>
        </div>
    </div>
</div>

<hr class="mb-5" />

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-award-fill"></i> Top Recruits</h5>
                <span class="badge bg-light text-dark">Total Heroes: @Model.TotalHeroes</span>
            </div>
            <div class="card-body">
                @if (Model.RecentHeroes.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var hero in Model.RecentHeroes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@hero.Name</strong>
                                    <span class="text-muted ms-2">@hero.GetType().Name</span>
                                </div>
                                <div>
                                    <span class="badge bg-success rounded-pill me-2">Lvl @hero.Level</span>
                                    <span class="badge bg-primary rounded-pill"><i class="bi bi-heart-fill"></i> HP: @hero.CurrentHP / @hero.MaxHP</span>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="text-center mt-3">
                        <a asp-page="/Heroes/Index" class="btn btn-sm btn-outline-secondary">View All Heroes</a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-emoji-frown text-muted" style="font-size: 2rem;"></i>
                        <p class="mt-2 text-muted">The tavern is currently empty. No heroes are registered yet.</p>
                        <a asp-page="/Heroes/Create" class="btn btn-primary">Create the first Hero!</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>