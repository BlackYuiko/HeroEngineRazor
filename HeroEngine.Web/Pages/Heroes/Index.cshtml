@page
@model HeroEngine.Web.Pages.Heroes.IndexModel
@{
    ViewData["Title"] = "Heroes List";
}

<h3>Heroes in the Tavern</h3>
<a asp-page="/Heroes/Create" class="btn btn-primary mb-3">Register New Hero</a>

@if (Model.HeroesList.Count == 0)
{
    <p class="text-muted">No heroes registered yet.</p>
}
else
{
    <ul class="list-group w-50">
        @foreach (var hero in Model.HeroesList)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@hero.Name</strong> - <span class="badge bg-secondary">@hero.GetType().Name</span>
                    <br />
                    <small>Level: @hero.Level | HP: @hero.CurrentHP</small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="/Heroes/Detail" asp-route-name="@hero.Name" class="btn btn-sm btn-info text-white">Details</a>

                    <form method="post" asp-page-handler="Delete" asp-route-name="@hero.Name"
                          onsubmit="return confirm('Are you sure you want to delete @hero.Name permanently?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </div>
            </li>
        }
    </ul>
}